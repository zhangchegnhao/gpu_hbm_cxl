{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sieve replay real-router trace manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_file", "trace_sha256", "model", "workload", "capture"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "trace_file": {"type": "string", "minLength": 1},
    "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "count"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "dtype", "num_hidden_layers", "num_experts", "num_experts_per_tok"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "dtype": {"type": "string", "minLength": 1},
        "num_hidden_layers": {"type": "integer", "minimum": 1},
        "num_experts": {"type": "integer", "minimum": 1},
        "num_experts_per_tok": {"type": "integer", "minimum": 1}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "dataset_revision", "split", "prompt_count", "batch_size", "decode_steps", "seed"],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "dataset_revision": {"type": "string", "minLength": 1},
        "split": {"type": "string", "minLength": 1},
        "prompt_count": {"type": "integer", "minimum": 1},
        "batch_size": {"type": "integer", "minimum": 1},
        "decode_steps": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "framework_version", "torch_version", "device_map", "created_at_utc", "timing_source"],
      "properties": {
        "framework": {"type": "string", "minLength": 1},
        "framework_version": {"type": "string", "minLength": 1},
        "torch_version": {"type": "string", "minLength": 1},
        "device_map": {"type": "string", "minLength": 1},
        "created_at_utc": {"type": "string", "minLength": 1},
        "timing_source": {"const": "routing-only; no hardware timing captured"},
        "generation_strategy": {"const": "greedy-argmax-fixed-steps"},
        "fixed_batch": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {
        "required": ["prompts"],
        "properties": {
          "capture": {
            "required": ["framework", "framework_version", "torch_version", "device_map", "created_at_utc", "timing_source", "generation_strategy", "fixed_batch"]
          }
        }
      }
    }
  ]
}
